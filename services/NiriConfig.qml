pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import qs.modules.common
import qs.modules.common.functions
import "NiriShortcuts.js" as Shortcuts

Singleton {
    id: root

    property alias options: adapter
    property bool ready: false
    property int readWriteDelay: 150
    property bool applyingConfig: false
    property var configFiles: [root.configPath]
    property var knownValues: ({})
    property var pendingChanges: ({})
    property var generatingChanges: ({})
    property bool refreshPending: false
    property bool focusFollowsMouseOwnedByConfig: false
    property bool preferNoCsd: false
    property string defaultColumnWidthKdl: ""
    property var externalWindowRules: []
    property string configError: ""
    signal configReloaded()
    readonly property string configPath: FileUtils.trimFileProtocol(`${Directories.config}/niri/config.kdl`)

    readonly property string qssettingsDir: FileUtils.trimFileProtocol(`${Directories.config}/niri/qssettings`)
    readonly property string settingsPath: `${qssettingsDir}/settings.json`
    readonly property string shellKdlPath: `${qssettingsDir}/shell.kdl`
    readonly property string outputsKdlPath: `${qssettingsDir}/outputs.kdl`
    readonly property string autostartKdlPath: `${qssettingsDir}/autostart.kdl`
    readonly property string bindsKdlPath: `${qssettingsDir}/binds.kdl`
    readonly property string windowrulesKdlPath: `${qssettingsDir}/windowrules.kdl`
    property var pendingWindowRule: null
    property bool validatingWindowRule: false
    property string windowRuleError: ""
    property var candidateWindowRules: []
    property string originalWindowRules: ""
    signal windowRuleSaved()
    property bool validatingBind: false
    property bool publishingBind: false
    readonly property bool savingBind: root.validatingBind || root.publishingBind
    property string bindError: ""
    property var candidateBinds: []
    property string originalBinds: ""
    property string candidateBindsKdl: ""
    signal bindSaveCompleted(bool success)
    // Must go at the END of config.kdl: later includes override earlier sections.
    readonly property string includeLines: 'include optional=true "qssettings/shell.kdl"\ninclude optional=true "qssettings/outputs.kdl"\ninclude optional=true "qssettings/autostart.kdl"\ninclude optional=true "qssettings/binds.kdl"\ninclude optional=true "qssettings/windowrules.kdl"'

    readonly property string generatedHeader: "// ! AUTO-GENERATED by the shell settings app. Do not edit, changes will be overwritten\n\n"

    Component.onCompleted: {
        Quickshell.execDetached(["mkdir", "-p", root.qssettingsDir])
    }

    function optionValue(path) {
        let value = adapter
        for (const key of path.split(".")) value = value[key]
        return value
    }

    function setOption(path, value) {
        const keys = path.split(".")
        const leaf = keys.pop()
        let target = adapter
        for (const key of keys) target = target[key]
        target[leaf] = value
    }

    function snapshot() {
        const result = {}
        for (const key of Object.keys(root.knownValues)) result[key] = root.optionValue(key)
        for (const key of ["autostart", "bindOverrides", "windowRules"])
            result[key] = JSON.parse(JSON.stringify(adapter[key]))
        return result
    }

    function trackChanges() {
        if (!root.ready || root.applyingConfig) return
        const current = root.snapshot()
        for (const key of Object.keys(current)) {
            if (JSON.stringify(current[key]) !== JSON.stringify(root.knownValues[key]))
                root.pendingChanges[key] = current[key]
        }
        root.knownValues = current
        if (Object.keys(root.pendingChanges).length) fileWriteTimer.restart()
    }

    function refreshConfig() {
        root.refreshPending = true
        configReadTimer.restart()
    }

    Timer {
        id: configReadTimer
        interval: root.readWriteDelay
        onTriggered: {
            if (configReadProc.running || configGenerateProc.running || fileWriteTimer.running) return
            root.refreshPending = false
            configReadProc.running = true
        }
    }

    Instantiator {
        model: root.configFiles
        delegate: FileView {
            required property string modelData
            path: modelData
            watchChanges: true
            printErrors: false
            onFileChanged: root.refreshConfig()
        }
    }

    Process {
        id: configReadProc
        command: ["python3", Quickshell.shellPath("scripts/niri/config-settings.py"), "--path", root.configPath]
        stdout: StdioCollector { id: configReadOutput }
        stderr: StdioCollector { id: configReadError }
        onExited: code => {
            if (code !== 0) {
                try { root.configFiles = JSON.parse(configReadOutput.text).files } catch (error) {}
                root.configError = Translation.tr("Could not read niri settings: %1").arg(configReadError.text.trim())
                return
            }
            if (Object.keys(root.pendingChanges).length || configGenerateProc.running) {
                root.refreshPending = true
                return
            }
            try {
                const result = JSON.parse(configReadOutput.text)
                root.applyingConfig = true
                for (const [key, value] of Object.entries(result.values)) root.setOption(key, value)
                root.knownValues = result.values
                root.knownValues = root.snapshot()
                if (JSON.stringify(root.configFiles) !== JSON.stringify(result.files)) root.configFiles = result.files
                root.focusFollowsMouseOwnedByConfig = result.focusFollowsMouseOwnedByConfig
                root.preferNoCsd = result.preferNoCsd
                root.defaultColumnWidthKdl = result.defaultColumnWidthKdl
                if (JSON.stringify(root.externalWindowRules) !== JSON.stringify(result.windowRules))
                    root.externalWindowRules = result.windowRules
                root.ready = true
                root.configReloaded()
            } catch (error) {
                root.configError = Translation.tr("Could not read niri settings: %1").arg(error.message)
            } finally {
                root.applyingConfig = false
            }
            if (root.refreshPending) root.refreshConfig()
        }
    }

    Process {
        id: configGenerateProc
        command: ["python3", Quickshell.shellPath("scripts/niri/config-settings.py"), "--path", root.configPath, "--generate"]
        onStarted: {
            write(JSON.stringify(root.generatingChanges))
            stdinEnabled = false
        }
        stdout: StdioCollector { id: configGenerateOutput }
        stderr: StdioCollector { id: configGenerateError }
        onExited: code => {
            if (code === 0) {
                root.configError = ""
                shellKdlFile.setText(root.generatedHeader + configGenerateOutput.text)
            } else {
                root.configError = Translation.tr("Could not save niri settings: %1").arg(configGenerateError.text.trim())
                root.refreshConfig()
            }
            root.generatingChanges = ({})
            if (Object.keys(root.pendingChanges).length) fileWriteTimer.restart()
            else if (root.refreshPending) root.refreshConfig()
        }
    }

    function kdlEscape(str) {
        return String(str).replace(/\\/g, "\\\\").replace(/"/g, '\\"')
            .replace(/\n/g, "\\n").replace(/\r/g, "\\r").replace(/\t/g, "\\t")
    }

    function windowRulesKdl(rules) {
        let kdl = "";
        for (const rule of rules) {
            if (rule.enabled === false) continue;
            const match = rule.match ?? {};
            const props = rule.properties ?? {};
            let terms = [];
            for (const [key, node] of [["appId", "app-id"], ["title", "title"]]) {
                if (match[key]) {
                    if (typeof match[key] !== "string" || /[\x00-\x08\x0b\x0c\x0e-\x1f]/.test(match[key]))
                        throw new Error("Invalid matcher");
                    terms.push(`${node}="${root.kdlEscape(match[key])}"`);
                }
            }
            for (const [key, node] of [["isFloating", "is-floating"], ["isFocused", "is-focused"]]) {
                if (match[key] !== null && match[key] !== undefined) {
                    if (typeof match[key] !== "boolean") throw new Error("Invalid matcher");
                    terms.push(`${node}=${match[key]}`);
                }
            }
            if (terms.length === 0) throw new Error("A rule needs a matcher");
            // Attributes in one match are ANDed; separate match nodes would be ORed.
            kdl += `window-rule {\n    match ${terms.join(" ")}\n`;
            for (const [key, node] of [["openFloating", "open-floating"], ["openMaximized", "open-maximized"],
                ["openFullscreen", "open-fullscreen"], ["clipToGeometry", "clip-to-geometry"]]) {
                if (props[key] !== null && props[key] !== undefined) {
                    if (typeof props[key] !== "boolean") throw new Error("Invalid property");
                    kdl += `    ${node} ${props[key]}\n`;
                }
            }
            for (const [key, node, min, max] of [["opacity", "opacity", 0, 1],
                ["columnWidth", "default-column-width", 0.01, 1], ["scrollFactor", "scroll-factor", 0.01, 100]]) {
                if (props[key] !== null && props[key] !== undefined) {
                    const value = props[key];
                    if (typeof value !== "number" || !isFinite(value) || value < min || value > max)
                        throw new Error("Invalid numeric property");
                    kdl += key === "columnWidth" ? `    ${node} { proportion ${value}; }\n` : `    ${node} ${value}\n`;
                }
            }
            if (props.blockOutFrom) {
                if (!["screencast", "screen-capture"].includes(props.blockOutFrom)) throw new Error("Invalid capture target");
                kdl += `    block-out-from "${props.blockOutFrom}"\n`;
            }
            kdl += "}\n\n";
        }
        return kdl;
    }

    function generateWindowRulesKdl() {
        try { windowrulesKdlFile.setText(root.generatedHeader + root.windowRulesKdl(adapter.windowRules)); }
        catch (error) { root.windowRuleError = Translation.tr("Invalid window rules: %1").arg(error.message); }
    }

    function saveWindowRule(index, rule) {
        if (root.validatingWindowRule) return;
        root.windowRuleError = "";
        const rules = Array.from(adapter.windowRules);
        if (index < 0) rules.push(rule);
        else if (index < rules.length) rules[index] = rule;
        else return;
        try {
            const kdl = root.windowRulesKdl(rules);
            root.originalWindowRules = JSON.stringify(adapter.windowRules);
            root.candidateWindowRules = rules;
            root.validatingWindowRule = true;
            validationFile.setText(kdl);
        } catch (error) {
            root.windowRuleError = Translation.tr("Invalid window rule: %1").arg(error.message);
        }
    }

    FileView {
        id: windowrulesKdlFile
        path: root.windowrulesKdlPath
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: validationFile
        path: `${root.qssettingsDir}/.windowrules-validation.kdl`
        blockLoading: true
        printErrors: false
        onSaved: if (root.validatingWindowRule) validationProc.exec(["niri", "validate", "-c", path])
        onSaveFailed: {
            root.validatingWindowRule = false;
            root.windowRuleError = Translation.tr("Could not write the window rule validation file.");
        }
    }
    Process {
        id: validationProc
        stderr: StdioCollector { id: validationError }
        onExited: code => {
            root.validatingWindowRule = false;
            if (code !== 0) {
                root.windowRuleError = Translation.tr("Niri rejected this rule: %1").arg(validationError.text.replace(/\x1b\[[0-9;]*m/g, "").trim());
            } else if (JSON.stringify(adapter.windowRules) !== root.originalWindowRules) {
                root.windowRuleError = Translation.tr("Rules changed while saving. Please try again.");
            } else {
                adapter.windowRules = root.candidateWindowRules;
                root.windowRuleSaved();
            }
        }
    }

    // Autostart entries live in adapter.autostart as {command: string, enabled: bool}.
    // Emitted as `spawn-at-startup "sh" "-c" "<command>"` — spawn-at-startup takes
    // argv (no shell), and wrapping in sh -c keeps pipes/env vars/~ working and is
    // supported by every niri version (unlike spawn-sh-at-startup, 25.08+).
    function generateAutostartKdl() {
        let kdl = root.generatedHeader
        kdl += "// Applied on the next niri start\n"
        for (const entry of (adapter.autostart ?? [])) {
            const cmd = String(entry?.command ?? "").trim()
            if (!entry?.enabled || cmd === "") continue
            kdl += `spawn-at-startup "sh" "-c" "${root.kdlEscape(cmd)}"\n`
        }
        autostartKdlFile.setText(kdl)
    }

    function bindsKdl(entries) {
        let kdl = "binds {\n"
        for (const entry of entries) {
            const key = String(entry?.key ?? "").trim()
            const action = String(entry?.action ?? "").trim().replace(/;\s*$/, "")
            if (!/^[A-Za-z0-9_]+(\+[A-Za-z0-9_]+)*$/.test(key) || action === "")
                throw new Error("Invalid shortcut key or action")
            const title = String(entry?.title ?? "").trim()
            let properties = title !== "" ? ` hotkey-overlay-title="${root.kdlEscape(title)}"` : ""
            for (const [name, value] of Object.entries(entry.properties ?? {})) {
                if (name === "hotkey-overlay-title") continue
                if (!/^[a-z][a-z0-9-]*$/.test(name)) throw new Error("Invalid shortcut property")
                if (typeof value === "string") properties += ` ${name}="${root.kdlEscape(value)}"`
                else if (typeof value === "boolean" || (typeof value === "number" && isFinite(value)))
                    properties += ` ${name}=${value}`
                else throw new Error("Invalid shortcut property value")
            }
            kdl += `    ${key}${properties} {\n${action.split("\n").map(line => "        " + line).join("\n")}\n    }\n`
        }
        return kdl + "}\n"
    }

    function generateBindsKdl() {
        try { bindsKdlFile.setText(root.generatedHeader + root.bindsKdl(adapter.bindOverrides)) }
        catch (error) {
            root.bindError = Translation.tr("Could not save shortcuts: %1").arg(error.message)
            root.publishingBind = false
            root.bindSaveCompleted(false)
        }
    }

    function saveBindOverride(originalKey, entry, modKey) {
        if (!root.ready || root.savingBind) return
        root.validateBindOverrides(Shortcuts.updatedOverrides(Array.from(adapter.bindOverrides), originalKey, entry, modKey))
    }

    function removeBindOverride(key, modKey) {
        if (!root.ready || root.savingBind) return
        const normalized = Shortcuts.normalizeKey(key, modKey)
        root.validateBindOverrides(Array.from(adapter.bindOverrides).filter(b => Shortcuts.normalizeKey(b.key, modKey) !== normalized))
    }

    function validateBindOverrides(entries) {
        root.bindError = ""
        if (JSON.stringify(entries) === JSON.stringify(adapter.bindOverrides)) {
            root.bindSaveCompleted(true)
            return
        }
        try {
            root.candidateBindsKdl = root.bindsKdl(entries)
            root.originalBinds = JSON.stringify(adapter.bindOverrides)
            root.candidateBinds = entries
            root.validatingBind = true
            bindValidationProc.stdinEnabled = true
            bindValidationProc.running = true
        } catch (error) {
            root.bindError = Translation.tr("Invalid shortcut: %1").arg(error.message)
            root.bindSaveCompleted(false)
        }
    }

    Process {
        id: bindValidationProc
        command: ["python3", Quickshell.shellPath("scripts/niri/list-binds.py"), "--validate"]
        onStarted: {
            write(JSON.stringify({kdl: root.candidateBindsKdl, actions: root.candidateBinds.map(b => b.action)}))
            stdinEnabled = false
        }
        stderr: StdioCollector { id: bindValidationError }
        onExited: code => {
            const entries = root.candidateBinds
            root.candidateBinds = []
            root.candidateBindsKdl = ""
            root.validatingBind = false
            if (code !== 0) {
                root.bindError = Translation.tr("Niri rejected this shortcut: %1").arg(bindValidationError.text.trim())
                root.bindSaveCompleted(false)
            } else if (JSON.stringify(adapter.bindOverrides) !== root.originalBinds) {
                root.bindError = Translation.tr("Shortcuts changed while saving. Please try again.")
                root.bindSaveCompleted(false)
            } else {
                root.publishingBind = true
                adapter.bindOverrides = entries
                // A self-write may still be reloading the adapter. This validated
                // edit must not depend on the passive change tracker's reload guard.
                root.pendingChanges.bindOverrides = entries
                root.knownValues.bindOverrides = JSON.parse(JSON.stringify(entries))
                fileWriteTimer.restart()
            }
        }
    }

    // monitors: array in MonitorConfigOption shape ({name, currentMode, x, y, scale, transform, disabled, vrr})
    function generateOutputsKdl(monitors) {
        let kdl = root.generatedHeader
        const transformNames = ["normal", "90", "180", "270"]
        for (const m of monitors) {
            kdl += `output "${m.name}" {\n`
            if (m.disabled) {
                kdl += "    off\n}\n\n"
                continue
            }
            const mode = m.currentMode.match(/(\d+)x(\d+)@([\d.]+)/)
            if (mode) kdl += `    mode "${mode[1]}x${mode[2]}@${parseFloat(mode[3]).toFixed(3)}"\n`
            kdl += `    scale ${m.scale}\n`
            if (m.transform) kdl += `    transform "${transformNames[m.transform] ?? "normal"}"\n`
            kdl += `    position x=${m.x} y=${m.y}\n`
            if (m.vrr) kdl += "    variable-refresh-rate\n"
            kdl += "}\n\n"
        }
        outputsKdlFile.setText(kdl)
    }

    Timer {
        id: fileWriteTimer
        interval: root.readWriteDelay
        onTriggered: {
            if (configGenerateProc.running) return
            const changes = root.pendingChanges
            root.pendingChanges = ({})
            if (changes.autostart !== undefined) root.generateAutostartKdl()
            if (changes.bindOverrides !== undefined) root.generateBindsKdl()
            if (changes.windowRules !== undefined) root.generateWindowRulesKdl()
            for (const key of ["autostart", "bindOverrides", "windowRules"]) delete changes[key]
            if (Object.keys(changes).length) {
                root.generatingChanges = changes
                configGenerateProc.stdinEnabled = true
                configGenerateProc.running = true
            } else {
                settingsFileView.writeAdapter()
                if (root.refreshPending) root.refreshConfig()
            }
        }
    }

    FileView {
        id: shellKdlFile
        path: root.shellKdlPath
        onSaved: {
            settingsFileView.writeAdapter()
            root.refreshConfig()
        }
        onSaveFailed: {
            root.configError = Translation.tr("Could not write the niri settings file.")
            root.refreshConfig()
        }
    }

    FileView {
        id: autostartKdlFile
        path: root.autostartKdlPath
    }

    FileView {
        id: bindsKdlFile
        path: root.bindsKdlPath
        onSaved: {
            if (!root.publishingBind) return
            root.publishingBind = false
            root.bindSaveCompleted(true)
        }
        onSaveFailed: {
            root.bindError = Translation.tr("Could not write the shortcuts file.")
            root.publishingBind = false
            root.bindSaveCompleted(false)
        }
    }

    FileView {
        id: outputsKdlFile
        path: root.outputsKdlPath
    }

    FileView {
        id: settingsFileView
        path: root.settingsPath
        watchChanges: true
        onFileChanged: {
            root.applyingConfig = true
            reload()
        }
        onAdapterUpdated: root.trackChanges()
        onLoaded: {
            root.applyingConfig = false
            root.refreshConfig()
        }
        onLoadFailed: error => {
            root.applyingConfig = false
            if (error == FileViewError.FileNotFound) root.refreshConfig()
            else root.configError = Translation.tr("Could not read saved niri settings.")
        }

        JsonAdapter {
            id: adapter

            property JsonObject layout: JsonObject {
                property real gaps: 3
                property string centerFocusedColumn: "on-overflow"
                property real defaultColumnWidth: 0.5
            }

            property JsonObject decoration: JsonObject {
                property real rounding: 12
                property JsonObject border: JsonObject {
                    property bool enable: true
                    property real width: 1
                }
                property JsonObject focusRing: JsonObject {
                    property bool enable: true
                    property real width: 2
                }
                property JsonObject shadow: JsonObject {
                    property bool enable: false
                    property real softness: 30
                    property real spread: 5
                }
                property JsonObject blur: JsonObject {
                    property bool enable: true
                    property int passes: 3
                    property real offset: 3.0
                    property real noise: 0.02
                    property real saturation: 1.2
                }
            }

            property JsonObject input: JsonObject {
                property string kbLayout: "us"
                property bool numlock: false
                property int repeatDelay: 600
                property int repeatRate: 25
                property bool focusFollowsMouse: false
                // Empty string = omit max-scroll-amount entirely
                property string focusFollowsMouseMaxScroll: ""
                property JsonObject touchpad: JsonObject {
                    property bool tap: true
                    property bool naturalScroll: true
                    property bool disableWhileTyping: false
                    property real scrollFactor: 1.0
                    property real accelSpeed: 0.0
                }
                property JsonObject mouse: JsonObject {
                    property bool naturalScroll: false
                    property real accelSpeed: 0.0
                }
            }

            property JsonObject animations: JsonObject {
                property bool enable: true
                property real slowdown: 1.0
            }

            property JsonObject cursor: JsonObject {
                property string theme: ""
                property int size: 24
                property bool hideWhenTyping: false
            }

            // [{command: string, enabled: bool}] -> qssettings/autostart.kdl
            property list<var> autostart: []

            // [{key: string, action: string, title: string}] -> qssettings/binds.kdl
            property list<var> bindOverrides: []
            property list<var> windowRules: []
        }
    }
}
